# LLM Provider
# Prod / shared dev: Azure OpenAI on UNDP's `cpc-tracker-ai-c657` Foundry resource.
# Local dev fallback: OpenRouter (https://openrouter.ai) — leave AZURE_OPENAI_ENDPOINT unset.

# Azure OpenAI (primary)
# Endpoint must be the bare base URL — no /openai/responses, no query string.
AZURE_OPENAI_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
AZURE_OPENAI_API_KEY=your-azure-key-here
AZURE_OPENAI_API_VERSION=2025-04-01-preview

# Deployment names (must match what's deployed in Azure AI Foundry)
LLM_MODEL=gpt-5.4         # used by the Python pipeline (classification, extraction, alignment)
LLM_CHAT_MODEL=gpt-5.4    # used by the in-app chat; falls back to LLM_MODEL if unset

# OpenRouter (fallback — only used if AZURE_OPENAI_ENDPOINT is unset)
# OPENROUTER_API_KEY="sk-or-v1-your-key-here"
# LLM_BASE_URL=https://openrouter.ai/api/v1

# Pipeline settings
LLM_CONCURRENCY=20
LLM_TEMPERATURE=0
