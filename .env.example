# LLM Provider
# Dev: OpenRouter (https://openrouter.ai) — get a key at openrouter.ai/keys
# Prod: Azure OpenAI — set LLM_BASE_URL to your Azure endpoint
OPENROUTER_API_KEY="sk-or-v1-your-key-here"
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o-mini

# Pipeline settings
LLM_CONCURRENCY=20
LLM_TEMPERATURE=0
