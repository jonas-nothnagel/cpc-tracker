# LLM Provider
# Prod / shared dev: Azure OpenAI on UNDP's `cpc-tracker-ai-c657` Foundry resource.
# Local dev fallback: OpenRouter (https://openrouter.ai) — leave AZURE_OPENAI_ENDPOINT unset.

# Azure OpenAI (primary)
# Endpoint must be the bare base URL — no /openai/responses, no query string.
AZURE_OPENAI_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
AZURE_OPENAI_API_KEY=your-azure-key-here
AZURE_OPENAI_API_VERSION=2025-04-01-preview

# Deployment names (must match what's deployed in Azure AI Foundry)
LLM_MODEL=gpt-5.4         # used by the Python pipeline (classification, extraction, alignment)
LLM_CHAT_MODEL=gpt-5.4    # used by the in-app chat; falls back to LLM_MODEL if unset

# OpenRouter (fallback — only used if AZURE_OPENAI_ENDPOINT is unset)
# OPENROUTER_API_KEY="sk-or-v1-your-key-here"
# LLM_BASE_URL=https://openrouter.ai/api/v1

# Pipeline settings
LLM_CONCURRENCY=20
LLM_TEMPERATURE=0

# Footprint tracking (carbon / energy / water of the AI compute)
# See docs/CARBON_METHODOLOGY.md.
#
# CPC_LEDGER_DIR: directory holding the shared append-only footprint-ledger.jsonl.
#   On Azure, set this to the persistent /home mount (same place as the cache) so
#   the ledger survives restarts and Python + Node resolve the same file. Leave
#   unset locally to default to python/output/.
# CPC_LEDGER_DIR=/home/data
#
# CPC_ELECTRICITY_ZONE: ISO 3166-1 alpha-3 electricity-mix zone for EcoLogits.
#   Default USA (matches the East US Azure deployment and the OpenAI provider
#   default, so historical numbers stay stable). Changing it changes the grid
#   carbon intensity and therefore the CO2 figures.
# CPC_ELECTRICITY_ZONE=USA
#
# CPC_RUN_SOURCE: set automatically by the analyze API to user_pipeline; a manual
#   CLI pipeline run defaults to dev_pipeline. You normally do not set this.
