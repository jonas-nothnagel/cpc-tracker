# Dependencies
node_modules/
.pnpm-store/

# Next.js
.next/
out/

# Build
dist/
build/

# Environment
.env
.env.local
.env.*.local

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Debug
npm-debug.log*
pnpm-debug.log*

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.uv/
*.egg-info/


# Testing
coverage/
.nyc_output/

# Cursor
.cursorindexingignore
.specstory/
.cursorrules
# Project-specific
docs/
old_scripts/
to-dos.txt
dev_data_scripts/
worklog/

# Analysis runs (ephemeral)
python/analyses/
python/output/.cache/
python/tmp/

# User feedback + usage analytics ledgers (live data; written at runtime to
# the persistent volume. Never commit: start.sh re-syncs committed output
# dirs from the image on every deploy and would wipe the persistent copy.)
python/output/feedback/
python/output/analytics/

# Compound-engineering review run artifacts
.context/

# External docs
external-docs/

# Tooling artifacts
.playwright-mcp/
.claude/
.mcp.json

# Deployment artifacts
.vercel

# Pipeline run logs (regenerated each run, not checked in). Pipeline
# *outputs* (the JSON artifacts the dashboard reads) stay tracked under
# python/output/{country}/{model}/ — only logs are excluded.
python/logs/
python/output/.run-logs/

# Local raw country corpora (zips + extracted, too large for git).
# Anchored to the repo root so `python/data/` (committed pipeline inputs)
# is not affected.
/data/

# Local feedback log copies (canonical .docx lives in SharePoint sync)
*.odt

# Raw pipeline inputs and intermediate proposals (kept local per country)
python/output/*/raw/
python/output/*/proposals/

# Per-run preview docs generated by parse_panama_ber.py (HITL self-review only).
python/output/*/*-pseudo-targets-preview.md
